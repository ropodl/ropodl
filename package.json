{
  "name": "saroj-projects",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "cf:dev": "node scripts/dev-cloudflare.mjs",
    "cf:watch": "node scripts/dev-cloudflare.mjs --watch-only",
    "cf:worker": "wrangler dev --ip 0.0.0.0 --port 8787",
    "cf:deploy": "pnpm build && wrangler deploy",
    "cf:d1:create": "wrangler d1 create saroj-portfolio",
    "cf:kv:create": "wrangler kv namespace create APP_KV",
    "cf:r2:create": "wrangler r2 bucket create saroj-portfolio-uploads",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply saroj-portfolio --local",
    "db:migrate:remote": "wrangler d1 migrations apply saroj-portfolio --remote",
    "db:seed:demo": "node scripts/seed-demo-content.mjs",
    "db:seed:admin": "node scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/sitemap": "^9.1.0",
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "nitropack": "^2.13.4",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.2"
  },
  "packageManager": "pnpm@12.11.2"
}
